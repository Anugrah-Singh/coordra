{
  "name": "coordra-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "description": "Coordra API for tenant-safe project coordination, realtime collaboration, and approval-gated Pulse actions.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage tests/*.test.ts",
    "build": "tsc",
    "start": "node --enable-source-maps dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{ts,json}\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{ts,mjs,json}\" \"README.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{ts,json}\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{ts,mjs,json}\" \"README.md\" \"docs/**/*.md\"",
    "backend:verify": "npm run typecheck && npm run test:typecheck && npm test && npm run build && npm audit --omit=dev",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend test",
    "frontend:build": "npm --prefix frontend run build",
    "verify": "npm run format:check && npm run typecheck && npm run test:typecheck && npm test && npm run test:integration && npm audit --omit=dev && npm run frontend:typecheck && npm run frontend:lint && npm run frontend:test && npm run build && npm run frontend:build"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "postgresql",
    "drizzle",
    "neon",
    "socket.io",
    "saas",
    "rbac"
  ],
  "author": "Anugrah Singh",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/groq": "^4.0.19",
    "ai": "^7.0.48",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "bcrypt@6.0.0": true,
    "@scarf/scarf@1.4.0": true
  }
}
