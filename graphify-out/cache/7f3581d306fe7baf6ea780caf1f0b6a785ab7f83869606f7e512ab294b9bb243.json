tion: 'PROJECT_CREATED',\n      entityType: 'project',\n      entityId: newProject.id,\n      oldValue: null,\n      newValue: {\n        name: newProject.name,\n        description: newProject.description,"},{"id":"service_getworkspaceprojects","label":"getWorkspaceProjects()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L66-L83","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L66"}],"snippet":"getWorkspaceProjects = async (data: {\n  workspaceId: string;\n  page?: string | undefined;\n  limit?: string | undefined;\n}) => {\n  const pagination = getPagination({\n    page: data.page,\n    limit: data.limit,\n  });\n\n  return await db\n    .select()\n    .from(projects)\n    .where(eq(projects.workspaceId, data.workspaceId))\n    .orderBy(desc(projects.createdAt), desc(projects.id))\n    .limit(pagination.limit)\n    .offset(pagination.offset);\n}"},{"id":"service_getprojectbyid","label":"getProjectById()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L85-L97","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L85"}],"snippet":"getProjectById = async (workspaceId: string, projectId: string) => {\n  const [project] = await db\n    .select()\n    .from(projects)\n    .where(and(eq(projects.workspaceId, workspaceId), eq(projects.id, projectId)))\n    .limit(1);\n\n  if (!project) {\n    throw createHttpError('Project not found', 404);\n  }\n\n  return project;\n}"},{"id":"service_getprojectsummary","label":"getProjectSummary()","file_type":"code","source_file":"/ho