n\n    const [updatedProject] = await tx\n      .update(projects)\n      .set({\n        name: data.name ?? existingProject.name,\n        description:\n          data.description !== undefined ? data.description : existingProject.description,\n        updatedAt: new Date(),\n      })\n      .where(\n        and(eq(projects.workspaceId, data.workspaceId), eq(projects.id, data.projectId))\n      )"},{"id":"service_deleteproject","label":"deleteProject()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L242-L286","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L242"}],"snippet":"deleteProject = async (data: {\n  workspaceId: string;\n  projectId: string;\n  actorId: string;\n}) => {\n  return await db.transaction(async (tx) => {\n    const [existingProject] = await tx\n      .select()\n      .from(projects)\n      .where(\n        and(eq(projects.workspaceId, data.workspaceId), eq(projects.id, data.projectId))\n      )\n      .limit(1);\n\n    if (!existingProject) {\n      throw createHttpError('Project not found', 404);\n    }\n\n    const [deletedProject] = await tx\n      .delete(projects)\n      .where(\n        and(eq(projects.workspaceId, data.workspaceId), eq(projects.id, data.projectId))\n      )\n      .returning();"}],"edges":[{"source":"service","target":"service","relation":"imports_from","confidence":"EXTRACTED","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/projects/service.ts","source_location":"L1"}],"weight":1},{"source":"service","target":"drizzle_orm",