{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"socket","label":"socket.ts","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L1"}]},{"id":"socket_parsecookies","label":"parseCookies()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L17-L33","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L17"}],"snippet":"parseCookies = (cookieHeader?: string): Record<string, string> => {\n  if (!cookieHeader) {\n    return {};\n  }\n\n  return cookieHeader.split(';').reduce<Record<string, string>>((cookies, item) => {\n    const [rawName, ...rawValueParts] = item.trim().split('=');\n\n    if (!rawName) {\n      return cookies;\n    }\n\n    cookies[rawName] = decodeURIComponent(rawValueParts.join('='));\n\n    return cookies;\n  }, {});\n}"},{"id":"socket_getworkspacemembership","label":"getWorkspaceMembership()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L35-L51","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L35"}],"snippet":"getWorkspaceMembership = async (workspaceId: string, userId: string) => {\n  const [membership] = await db\n    .select({\n      id: workspaceMembers.id,\n      role: workspaceMembers.role,\n    })\n    .from(workspaceMembers)\n    .where(\n      and(\n        eq(workspaceMembers.workspaceId, workspaceId),\n        eq(workspaceMembers.userId, userId)\n      )\n    )\n    .limit(1);\n\n  return membership;\n}"},{"id":"socket_initsocket","label":"initSocket()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L53-L154","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L53"}],"snippet":"initSocket = (server: HttpServer): Server => {\n  const socketServer = new Server(server, {\n    cors: {\n      origin: env.FRONTEND_URL,\n      methods: ['GET', 'POST', 'PATCH', 'PUT', 'DELETE'],\n      credentials: true,\n    },\n  });\n\n  io = socketServer;\n\n  socketServer.use((socket, next) => {\n    try {\n      const cookies = parseCookies(socket.handshake.headers.cookie);\n\n      const token = cookies[AUTH_COOKIE_NAME];\n\n      if (!token) {\n        next(new Error('Authentication required'));\n        return;\n      }\n\n      const decoded = verifyAuthToken(token);\n\n      socket.data.userId = decoded.userId;"},{"id":"socket_getio","label":"getIo()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L156-L162","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L156"}],"snippet":"getIo = (): Server => {\n  if (!io) {\n    throw new Error('Socket.IO has not been initialized');\n  }\n\n  return io;\n}"},{"id":"socket_getioifinitialized","label":"getIoIfInitialized()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L164-L166","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L164"}],"snippet":"getIoIfInitialized = (): Server | undefined => {\n  return io;\n}"},{"id":"socket_closesocketserver","label":"closeSocketServer()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L168-L181","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L168"}],"snippet":"closeSocketServer = async (): Promise<void> => {\n  if (!io) {\n    return;\n  }\n\n  const socketServer = io;\n  io = undefined;\n\n  await new Promise<void>((resolve) => {\n    socketServer.close(() => {\n      resolve();\n    });\n  });\n}"}],"edges":[{"source":"socket","target":"http","relation":"imports_from","confidence":"EXTRACTED","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L1"}],"weight":1},{"source":"socket","target":"drizzle_orm","relation":"imports_from","confidence":"EXTRACTED","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L3"}],"weight":1},{"source":"socket","target":"verifytoken","relation":"imports_from","confidence":"EXTRACTED","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/socket.ts","source_location":"L4"}],"weight":1},{"source":"socket","target":"so