alized();\n\n  if (!io) {\n    return false;\n  }\n\n  io.to(`user:${userId}`).emit(\n    'notifications:changed',\n    eventName === 'notifications:changed'\n      ? payload\n      : { action: eventName.replace(/^notification(s)?_/, ''), ...(payload as object) }\n  );\n\n  return true;\n}"}],"edges":[{"source":"socketevents","target":"socket","relation":"imports_from","confidence":"EXTRACTED","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/utils/socketEvents.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/utils/socketEvents.ts","source_location":"L1"}],"weight":1},{"source":"socketevents","target":"socketevents_emitworkspaceevent","relation":"contains","confidence":"EXTRACTED","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/utils/socketEvents.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/utils/socketEvents.ts","source_location":"L3"}],"weight":1},{"source":"socketevents","target":"socketevents_emituserevent","relation":"contains","confidence":"EXTRACTED","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/utils/socketEvents.ts","source_location":"L31","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/utils/socketEvents.ts","source_location":"L31"}],"weight":1}]}