eground\">{value}</span>\n  </span>\n)","node_kind":"component"},{"id":"pulseproposal_proposaldiffsummary","label":"ProposalDiffSummary()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseProposal.tsx","source_location":"L29-L51","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseProposal.tsx","source_location":"L29"}],"snippet":"ProposalDiffSummary = ({ payload }: { payload: PulseProposal['payload'] }) => {\n  const diffs: Array<{ label: string; value: string }> = [];\n\n  if (payload.status)\n    diffs.push({ label: 'Status', value: payload.status.replaceAll('_', ' ') });\n  if (payload.priority) diffs.push({ label: 'Priority', value: payload.priority });\n  if (payload.assigneeName !== undefined)\n    diffs.push({ label: 'Assignee', value: payload.assigneeName || 'Unassigned' });\n  if (payload.title) diffs.push({ label: 'Title', value: payload.title });\n\n  if (diffs.length === 0) return null;\n\n  return (\n    <div className=\"flex flex-wrap items-center gap-1.5 rounded-lg border border-primary/20 bg-primary/5 p-2 my-1\">\n      <span className=\"w-full text-[10px] font-semibold uppercase tracking-wider text-muted-foreground\">\n        Proposed Modifications\n      </span>\n      {diffs.map((diff) => (\n        <DiffBadge key={diff.label} label={diff.label} value={diff.value} />\n      ))}\n    </div>\n  );\n}","node_kind":"component"},{"id":"pulseproposal_pulseproposalcard","label":"PulseProposalCard()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseProposal.tsx","source_location":"L53-L346","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/f