{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"pulsemessage","label":"PulseMessage.tsx","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L1"}]},{"id":"pulsemessage_formatinline","label":"formatInline()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L5-L17","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L5"}],"snippet":"formatInline = (text: string) => {\n  const parts = text.split(/(\\*\\*[^*]+\\*\\*)/g);\n  return parts.map((part, index) => {\n    if (part.startsWith('**') && part.endsWith('**')) {\n      return (\n        <strong key={index} className=\"font-semibold text-foreground\">\n          {part.slice(2, -2)}\n        </strong>\n      );\n    }\n    return part;\n  });\n}"},{"id":"pulsemessage_parsetableline","label":"parseTableLine()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L28-L35","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L28"}],"snippet":"parseTableLine = (line: string): string[] =>\n  line\n    .split('|')\n    .map((c) => c.trim())\n    .filter(\n      (c, idx, arr) =>\n        (idx > 0 && idx < arr.length - 1) || (arr.length <= 2 && c.length > 0)\n    )"},{"id":"pulsemessage_parseblocks","label":"parseBlocks()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L37-L123","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L37"}],"snippet":"parseBlocks = (content: string): Block[] => {\n  const rawLines = content.split('\\n');\n  const blocks: Block[] = [];\n  let i = 0;\n\n  while (i < rawLines.length) {\n    const line = rawLines[i];\n    const trimmed = line.trim();\n\n    if (!trimmed) {\n      i++;\n      continue;\n    }\n\n    // Markdown Table Detection\n    if (\n      trimmed.includes('|') &&\n      (trimmed.startsWith('|') ||\n        (i + 1 < rawLines.length && rawLines[i + 1].trim().includes('|')))\n    ) {\n      const tableLines: string[] = [];\n      while (i < rawLines.length && rawLines[i].trim().includes('|')) {\n        tableLines.push(rawLines[i].trim());\n        i++;\n      }"},{"id":"pulsemessage_formattedcontent","label":"FormattedContent()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L125-L231","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L125"}],"snippet":"FormattedContent = ({ content }: { content: string }) => {\n  const blocks = parseBlocks(content);\n\n  return (\n    <div className=\"space-y-2.5 text-sm leading-relaxed\">\n      {blocks.map((block, idx) => {\n        if (block.type === 'header') {\n          return (\n            <h4\n              key={idx}\n              className=\"mt-4 mb-1 text-xs font-semibold uppercase tracking-wider text-primary border-b border-border/40 pb-1 flex items-center gap-1.5\"\n            >\n              <Sparkles size={13} className=\"text-primary shrink-0\" />\n              {formatInline(block.text)}\n            </h4>\n          );\n        }\n\n        if (block.type === 'table') {\n          return (\n            <div\n              key={idx}\n              className=\"my-3 overflow-x-auto rounded-xl border border-border/60 bg-card shadow-2xs\"\n            >\n              <table className=\"w-full text-left text-xs border-collapse\">","node_kind":"component"},{"id":"pulsemessage_pulsemessage","label":"PulseMessage()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L233-L281","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/frontend/src/features/assistant/PulseMessage.tsx","source_location":"L233"}],"snippet":"PulseMessage = ({\n  message,\n  onRetry,\n  children,\n}: {\n  message: PulseMessageItem;\n  onRetry: (prompt: string) => void;\n  children?: React.ReactNode;\n}) => (\n  <li\n    className={\n      message.role === 'user'\n        ? 'ml-10 rounded-2xl rounded-br-md bg-primary px-4 py-3 text-sm text-primary-foreground shadow-xs'\n        : 'mr-4 rounded-2xl rounded-bl-md border border-border/60 bg-card/95 backdrop-blur-xs px-4 py-3 text-sm shadow-sm'\n    }\n  >\n    {message.role === 'user' ? (\n      <p className=\"whitespace-pre-wrap leading-relaxed\">{message.content}</p>\n    ) : (\n      <FormattedContent content={message.content} />\n    )}\n    {message.activities?.length ? (\n      <ul className=\"mt-3 space-y-1 border-t border-border/40 pt-2.5 text-xs text-muted-foreground\">\n        {message.activities.map((activity) => (\n          <li className=\"flex items-center gap-1