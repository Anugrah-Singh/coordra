dRequest('The proposal contains an unsupported editable field');\n    }\n    candidate = {"},{"id":"service_rejectproposal","label":"rejectProposal()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/assistant/service.ts","source_location":"L197-L213","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/assistant/service.ts","source_location":"L197"}],"snippet":"rejectProposal = async (input: {\n  workspaceId: string;\n  requesterId: string;\n  proposalId: string;\n}) => {\n  const proposal = await getOwnedProposal(input);\n  await ensurePending(proposal);\n  const [rejected] = await db\n    .update(aiActionProposals)\n    .set({ status: 'REJECTED' })\n    .where(\n      and(eq(aiActionProposals.id, proposal.id), eq(aiActionProposals.status, 'PENDING'))\n    )\n    .returning();\n  if (!rejected) throw AppError.conflict('This proposal is no longer pending');\n  return sanitizeProposal(rejected);\n}"},{"id":"service_approveproposal","label":"approveProposal()","file_type":"code","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/assistant/service.ts","source_location":"L215-L345","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/home/shubham-singh/code/SAAS-Team-Workspace-cleanup/src/domains/assistant/service.ts","source_location":"L215"}],"snippet":"approveProposal = async (input: {\n  workspaceId: string;\n  requesterId: string;\n  proposalId: string;\n  now?: Date | undefined;\n}) => {\n  const now = input.now ?? new Date();\n  const existing = await getOwnedProposal(input);\n  await ensurePending(existing, now);\n  let executionStarted = false;\n\n  try {\n    return await db.transaction(async (tx) => {\n      const [membership] = await tx\n        .select({ role: workspaceMembers.role })\n        .from(worksp